{
  "name": "dsh-opencode-go-catalog",
  "version": "0.2.0",
  "description": "Live-maintained OpenCode Go model catalog for DeepSeek Harness: protocol-separated sibling routes (extras/responses/messages) via the settings.mutate seam. Membership is rebuilt from the live roster plus the docs endpoint table on every sync, so new models appear and retired ones drop out without hand work. Never touches the built-in opencode-go route.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/reasoning.mjs",
    "lib/protocols.mjs",
    "lib/live.mjs",
    "bin/sync.mjs",
    "bin/snippet.mjs",
    "cordis.patch.yml",
    "catalog/models.json",
    "weg-a-schnellstart.yml",
    "verify.mjs",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "AincradLabs",
  "repository": {
    "type": "git",
    "url": "https://github.com/AincradLabs/dsh-opencode-go-catalog.git"
  },
  "bugs": {
    "url": "https://github.com/AincradLabs/dsh-opencode-go-catalog/issues"
  },
  "homepage": "https://github.com/AincradLabs/dsh-opencode-go-catalog#readme",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "opencode-go", "llm", "model-catalog"],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
